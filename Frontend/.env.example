[TEMPLATE]
# Volta frontend environment example
#
# Copy this file to `.env` (untracked) and adjust values as needed.
# Only variables prefixed with VITE_ are exposed to the browser bundle —
# NEVER put secrets here; they are embedded in the public build output.
#
# API base URL used by src/services/api.js (axios).
#
# Local development: leave it unset (commented out below). The code falls
# back to http://localhost:3000/api, which matches the local backend.
#
# Deployment: set it to your deployed backend URL at build time, e.g. on your
# hosting provider's dashboard (Vercel: Project Settings -> Environment
# Variables) or in CI. Process env vars override this file — no source edits
# are needed. Replace the placeholder with the real backend URL.
#
# VITE_API_BASE_URL=https://your-backend-host.example.com/api
