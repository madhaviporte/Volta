# Volta backend environment example
#
# Copy this file to `.env` (untracked — Backend/.gitignore already excludes it)
# and fill in real values. NEVER commit real credentials, JWT secrets or
# connection strings. Only variable NAMES are ever printed by the server.

# --- Required (the server refuses to start without these) -------------------
# MongoDB connection string (Atlas or local). The database name in the path
# is the one the app uses for real data.
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/volta?retryWrites=true&w=majority

# Secret used to sign and verify JWTs. Use a long random string, e.g.
# `openssl rand -hex 32`. Rotating it invalidates all issued tokens.
JWT_SECRET=replace-with-a-long-random-secret

# --- Optional (sensible defaults) -------------------------------------------
# HTTP port. Invalid or blank falls back to 3000.
# PORT=3000

# Deployment marker. Set to production on the host: the localhost dev and
# preview CORS origins are only added when this is NOT "production", so a
# deployed backend must name its frontend origin in CORS_ALLOWED_ORIGINS
# below. Render and similar hosts set NODE_ENV automatically.
# NODE_ENV=production

# Token lifetime (jsonwebtoken format). Default: 7d
# JWT_EXPIRES_IN=7d

# Comma-separated frontend origins allowed by CORS. Outside production the
# local dev/preview origins (localhost:5173 and localhost:4173, plus
# 127.0.0.1 variants) are added automatically.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Set to 1 when running behind a single reverse proxy, so the login rate
# limiter keys on the real client IP instead of the proxy.
# TRUST_PROXY=1

# Failed-login budget per client per 15 minutes (default 10). Primarily for
# test environments, which raise it so negative tests never trip the limiter.
# LOGIN_RATE_LIMIT=10

# --- DNS resilience for MongoDB (optional) ----------------------------------
# A mongodb+srv connection resolves DNS through two paths: SRV/TXT records
# (Node's c-ares resolver, dns.setServers) and the TLS socket hostname
# (dns.lookup / getaddrinfo, the OS resolver). The OS resolver is always
# tried first and behaves exactly as before; only when it fails for a name
# does the lookup retry through public resolvers. SRV lookups keep the
# system resolvers first and use the public ones as failover, so networks
# with working DNS are unaffected while flaky/blocked DNS gets rescued.
#
# Comma-separated DNS server IPs used as the fallback (Google and
# Cloudflare by default). Set a custom list, or set it blank to disable
# the public fallback entirely (system resolvers only).
# DNS_FALLBACK_SERVERS=8.8.8.8,1.1.1.1

# --- Email notifications (optional) -----------------------------------------
# CURRENT SETUP: the Gmail API over OAuth2 is the PRIMARY provider
# (EMAIL_PROVIDER=gmail). The original SMTP transport is kept as a
# fallback and is used whenever EMAIL_PROVIDER=smtp is set explicitly -
# there is no silent automatic switch between providers, so a delivery
# failure is always reported instead of being retried over a second
# transport and possibly delivered twice. Setting EMAIL_ENABLED=false
# turns outgoing email off entirely while in-app notifications and the
# Notification Bell keep working exactly as before.
EMAIL_ENABLED=true
#
# Outgoing email is off unless EMAIL_ENABLED is not "false" AND every
# setting of the SELECTED provider is present. In-app notifications and the
# Notification Bell always work, with or without email.
#
# EMAIL_PROVIDER picks the transport (default when unset: smtp):
#   gmail  - PRIMARY. Gmail API over OAuth2/HTTPS, works locally and on
#            Render Free (no SMTP ports involved at all)
#   smtp   - FALLBACK. The original Gmail SMTP transport, retained as-is;
#            used only when selected explicitly
#   resend - Resend HTTPS API, for hosts that block outbound SMTP ports
#            25/465/587
# Only ONE provider sends at a time; the others stay available by changing
# EMAIL_PROVIDER. Nothing falls back automatically.
#
# GMAIL API (current setup - no SMTP ports, no app password):
#   EMAIL_ENABLED=true
#   EMAIL_PROVIDER=gmail
#   EMAIL_FROM=doreply.volta@gmail.com
#   GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
#   GOOGLE_CLIENT_SECRET=your-oauth-client-secret
#   GOOGLE_REFRESH_TOKEN=your-long-lived-refresh-token
#
# SMTP FALLBACK (the original transport - local development):
#   EMAIL_ENABLED=true
#   EMAIL_PROVIDER=smtp
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-account@gmail.com
#   SMTP_PASS=your-gmail-app-password
#   SMTP_FROM=your-account@gmail.com
#
# RESEND (another HTTPS option for hosts that block SMTP):
#   EMAIL_ENABLED=true
#   EMAIL_PROVIDER=resend
#   RESEND_API_KEY=
#   EMAIL_FROM=Volta Notifications <notifications@yourdomain.com>
#
# The Gmail access token is fetched automatically from the refresh token and
# cached in memory until shortly before it expires; no app password or
# SMTP is involved. The refresh token must come from Google's OAuth
# consent flow with the gmail.send scope.
#
# NEVER commit real credentials - fill these in on the server / in your
# local untracked .env only. Keys and passwords are never printed or logged;
# if the selected provider is missing a setting, the server logs one error
# naming the missing variable(s) and sends no email at all (never pretends
# an email went out).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=your-gmail-app-password
# SMTP_FROM=your-account@gmail.com
# EMAIL_PROVIDER=smtp
# RESEND_API_KEY=
# EMAIL_FROM=

# Recipient used by the manual email check
# (`node src/scripts/testEmail.js`). Read only by that script, never by the
# running server.
# TEST_EMAIL_TO=you@example.com

# Public origin of the deployed frontend, used for the action link in
# notification emails. Real routes only: /tasks/{id} and /meetings.
# Leave unset to send emails without the button.
# FRONTEND_BASE_URL=https://your-frontend.example.com

# Set to false to disable outgoing email entirely (in-app notifications
# keep working). Any other value = enabled whenever the selected provider's
# settings are present. (EMAIL_ENABLED itself is set to true at the top of
# this email section.)
# EMAIL_ENABLED=false

# --- Initial manager account (npm run seed:manager) -------------------------
# Credentials for seeding the first manager. Read only by the seed script;
# the running API never reads them. Set and change these before seeding a
# fresh database, and never commit real values.
# SEED_MANAGER_EMAIL=manager@example.com
# SEED_MANAGER_PASSWORD=change-this-before-seeding

# --- Test suite (npm test) --------------------------------------------------
# The tests spawn the real server against a DEDICATED test database and
# delete their own data there; they never touch the real database.
#
# TEST_MONGO_URI is optional. When unset, the suite derives the test
# database from MONGO_URI by replacing the database name with `volta_test`.
# When set, it must point at a dedicated test database — the suite refuses
# to run if its database equals the one in MONGO_URI.
# TEST_MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/volta_test?retryWrites=true&w=majority
