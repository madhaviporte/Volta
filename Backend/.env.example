# Volta backend environment example
#
# Copy this file to `.env` (untracked — Backend/.gitignore already excludes it)
# and fill in real values. NEVER commit real credentials, JWT secrets or
# connection strings. Only variable NAMES are ever printed by the server.

# --- Required (the server refuses to start without these) -------------------
# MongoDB connection string (Atlas or local). The database name in the path
# is the one the app uses for real data.
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/volta?retryWrites=true&w=majority

# Secret used to sign and verify JWTs. Use a long random string, e.g.
# `openssl rand -hex 32`. Rotating it invalidates all issued tokens.
JWT_SECRET=replace-with-a-long-random-secret

# --- Optional (sensible defaults) -------------------------------------------
# HTTP port. Invalid or blank falls back to 3000.
# PORT=3000

# Token lifetime (jsonwebtoken format). Default: 7d
# JWT_EXPIRES_IN=7d

# Comma-separated frontend origins allowed by CORS. Outside production the
# local dev/preview origins (localhost:5173 and localhost:4173, plus
# 127.0.0.1 variants) are added automatically.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Set to 1 when running behind a single reverse proxy, so the login rate
# limiter keys on the real client IP instead of the proxy.
# TRUST_PROXY=1

# Failed-login budget per client per 15 minutes (default 10). Primarily for
# test environments, which raise it so negative tests never trip the limiter.
# LOGIN_RATE_LIMIT=10

# --- Gmail email notifications (optional) -----------------------------------
# Email is sent only when all of the SMTP_* values below are set, unless
# EMAIL_ENABLED=false turns it off without unsetting them. When SMTP is
# missing or disabled the app behaves exactly as before: in-app
# notifications only. NEVER commit real credentials - fill these in on the
# server / in your local untracked .env only.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=your-gmail-app-password
# SMTP_FROM=your-account@gmail.com

# Public origin of the deployed frontend, used for the action link in
# notification emails. Real routes only: /tasks/{id} and /meetings.
# Leave unset to send emails without the button.
# FRONTEND_BASE_URL=https://your-frontend.example.com

# Set to false to disable outgoing email entirely (in-app notifications
# keep working). Any other value = enabled whenever SMTP_* are present.
# EMAIL_ENABLED=false

# --- Test suite (npm test) --------------------------------------------------
# The tests spawn the real server against a DEDICATED test database and
# delete their own data there; they never touch the real database.
#
# TEST_MONGO_URI is optional. When unset, the suite derives the test
# database from MONGO_URI by replacing the database name with `volta_test`.
# When set, it must point at a dedicated test database — the suite refuses
# to run if its database equals the one in MONGO_URI.
# TEST_MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/volta_test?retryWrites=true&w=majority
